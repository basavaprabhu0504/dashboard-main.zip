# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=quantum-vpn-secret-key-change-in-production

# QVPN Flask control-agent URLs for Classical VPN operations
QVPN_SERVER_AGENT_URL=http://192.168.56.102:8000
QVPN_CLIENT_AGENT_URL=http://192.168.56.101:8000
QVPN_AGENT_TIMEOUT_SECONDS=8

# Server VM Configuration (used by SSH-based monitoring, logs, performance, and chat)
SERVER_VM_HOST=192.168.56.102
SERVER_VM_PORT=22
SERVER_VM_USER=ubuntu
SERVER_VM_PASSWORD=ubuntu
SERVER_VM_SUDO_PASSWORD=ubuntu
SERVER_VM_KEY_PATH=

# Client VM Configuration (Ubuntu Client)
CLIENT_VM_HOST=192.168.56.101
CLIENT_VM_PORT=22
CLIENT_VM_USER=ubuntu
CLIENT_VM_PASSWORD=ubuntu
CLIENT_VM_SUDO_PASSWORD=ubuntu
CLIENT_VM_KEY_PATH=

# OpenVPN Configuration Paths & Unit Names
OPENVPN_SERVER_UNIT=openvpn-server@server
OPENVPN_CLIENT_CONF=/etc/openvpn/client/client.conf
TUNNEL_INTERFACE=tun0
SERVER_TUNNEL_IP=10.8.0.1
CLIENT_TUNNEL_IP=10.8.0.2

# Chat Scripts Configuration
CHAT_SERVER_PATH=/home/ubuntu/chat_server.py
CHAT_CLIENT_PATH=/home/ubuntu/chat_client.py
